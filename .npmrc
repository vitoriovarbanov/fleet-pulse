# Security settings for npm
# @see https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

# Ensure package-lock.json is always created/updated
package-lock=true

# Fail on high severity vulnerabilities during install
audit-level=high

# Use exact versions to prevent unexpected updates
save-exact=true

# Only use the official npm registry
registry=https://registry.npmjs.org/
